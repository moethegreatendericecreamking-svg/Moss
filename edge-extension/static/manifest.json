{
  "manifest_version": 3,
  "name": "Side Panel Chat for Claude",
  "short_name": "Claude Chat",
  "version": "1.0.0",
  "description": "Unofficial. Chat with Claude in Edge's side panel and ask about the page you're on. Uses your own Anthropic API key.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Chat with Claude",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open the Claude side panel"
    }
  },
  "permissions": ["sidePanel", "storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "optional_host_permissions": ["<all_urls>"]
}
