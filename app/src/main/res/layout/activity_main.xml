<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/moss"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Protection -->
        <TextView
            style="@style/Moss.Section"
            android:text="@string/section_protection" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <Button
            android:id="@+id/enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/restricted_help"
            style="@style/Moss.Help"
            android:text="@string/restricted_help" />

        <Button
            android:id="@+id/app_info"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_info" />

        <!-- What to block -->
        <TextView
            style="@style/Moss.Section"
            android:text="@string/section_block" />

        <Switch
            android:id="@+id/block_spotlight"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/block_spotlight"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/stories_title"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/stories_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/stories_hide_discover"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/stories_hide_discover" />

            <RadioButton
                android:id="@+id/stories_block"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/stories_block" />

            <RadioButton
                android:id="@+id/stories_allow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/stories_allow" />
        </RadioGroup>

        <Switch
            android:id="@+id/block_map"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/block_map"
            android:textSize="16sp" />

        <Button
            android:id="@+id/open_snapchat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/open_snapchat" />

        <!-- Troubleshooting -->
        <TextView
            style="@style/Moss.Section"
            android:text="@string/section_trouble" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_seen_label"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/last_seen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            style="@style/Moss.Help"
            android:text="@string/trouble_help" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/record"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/record" />

            <Button
                android:id="@+id/share"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/share" />
        </LinearLayout>

        <TextView
            style="@style/Moss.Help"
            android:layout_marginTop="20dp"
            android:text="@string/privacy_note" />
    </LinearLayout>
</ScrollView>
